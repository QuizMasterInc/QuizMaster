rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-questions collection
    match /default-questions/{questionId} {
      // Anyone can read default questions (needed for quizzes)
      allow read: if true;

      // Only authenticated users with developer role can write
      // You may want to add a custom claim check here
      allow write: if request.auth != null &&
        (request.auth.token.developer == true || request.auth.token.admin == true);
    }

    // Custom quizzes collection
    match /custom_quizzes/{quizId} {
      // Anyone can read public quizzes
      allow read: if resource.data.metadata.isPublic == true ||
        (request.auth != null && resource.data.creator.uid == request.auth.uid);

      // Only authenticated users can create their own quizzes
      allow create: if request.auth != null &&
        request.resource.data.creator.uid == request.auth.uid;

      // Only the creator can update/delete their own quiz
      allow update, delete: if request.auth != null &&
        resource.data.creator.uid == request.auth.uid;
    }

    // Flashcard decks collection
      match /flashcard_decks/{deckId} {
    // Anyone can read public decks, or creator can read their own
    allow read: if resource.data.isPublic == true ||
      (request.auth != null && resource.data.creatorId == request.auth.uid);

    // Only authenticated users can create their own decks
    allow create: if request.auth != null &&
      request.resource.data.creatorId == request.auth.uid;

    // Only the creator can update/delete their own deck
    allow update, delete: if request.auth != null &&
      resource.data.creatorId == request.auth.uid;
}

    // Quiz results collection
    match /quiz_results/{resultId} {
      // Users can only read their own results
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // Users can only create their own results
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      // No updates or deletes allowed
      allow update, delete: if false;
    }

    // Study materials collection
    match /studyMaterials/{materialId} {
      // Anyone can read public materials
      allow read: if resource.data.isPublic == true ||
        (request.auth != null && resource.data.createdBy == request.auth.uid);

      // Authenticated users can create materials
      allow create: if request.auth != null;

      // Only the creator can update/delete
      allow update, delete: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
    }

    // Study sessions collection
    match /study_sessions/{sessionId} {
      // Users can only read their own study sessions
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // Users can only create their own study sessions
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      // Users can only update their own study sessions
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid;

      // Users can delete their own study sessions
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // Quiz drafts collection (auto-save in-progress quizzes)
    match /quiz_drafts/{draftId} {
      allow read: if request.auth != null;
    
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
    
      allow update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own data
      allow read: if request.auth != null && request.auth.uid == userId;

      // Users can create/update their own data
      allow create, update: if request.auth != null && request.auth.uid == userId;

      // No deletes allowed
      allow delete: if false;
    }

    // Feedback collection
    match /feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Polls collection (live classroom polls)
    match /polls/{pollId} {
      // Anyone can read polls (needed for joining by code + live updates/results)
      allow read: if true;

      // Create requires auth so we can securely identify the poll creator/host.
      // Students can still join/vote without being authenticated.
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.joinCode is string
        && request.resource.data.question is string
        && request.resource.data.options is list
        && request.resource.data.votes is list
        && request.resource.data.options.size() >= 2
        && request.resource.data.options.size() <= 6
        && request.resource.data.votes.size() == request.resource.data.options.size()
        && request.resource.data.status in ['open', 'closed'];

      // Updates
      allow update: if (
          // Creator-only controls
          request.auth != null
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'showLiveResults', 'updatedAt'])
          && request.resource.data.status in ['open', 'closed']
        ) || (
          // Authenticated vote write: must also create a vote doc in the same request
          request.auth != null
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['votes', 'updatedAt'])
          && request.resource.data.votes is list
          && request.resource.data.votes.size() == resource.data.options.size()
          && resource.data.status == 'open'
          && !exists(/databases/$(database)/documents/polls/$(pollId)/votes/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/polls/$(pollId)/votes/$(request.auth.uid))
        );

      // No deletes (keeps poll history stable; adjust later if needed)
      allow delete: if false;

      // Votes subcollection: exactly one document per userId
      match /votes/{userId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && get(/databases/$(database)/documents/polls/$(pollId)).data.status == 'open'
          && request.resource.data.optionIndexes is list
          && request.resource.data.optionIndexes.size() > 0
          && request.resource.data.optionIndexes.size() <= get(/databases/$(database)/documents/polls/$(pollId)).data.options.size();
        // Prevent rewrites (one vote per uid)
        allow update, delete: if false;
      }
    }

    // Block everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
